# Copy to .env and fill in. Never commit .env.
#
#   SALT / NEXTAUTH_SECRET     python3 -c "import secrets; print(secrets.token_hex(16))"
#   ENCRYPTION_KEY             python3 -c "import secrets; print(secrets.token_hex(32))"
#   project keys               python3 -c "import uuid; print('pk-lf-'+str(uuid.uuid4()))"
#                              python3 -c "import uuid; print('sk-lf-'+str(uuid.uuid4()))"
#   passwords                  python3 -c "import secrets; print(secrets.token_urlsafe(18))"

LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
NEXTAUTH_SECRET=

POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=

# Headless bootstrap of the org, project and admin user on first boot.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_PASSWORD=
